# ===== DB =====
POSTGRES_USER=videoexplore
POSTGRES_PASSWORD=videoexplore
POSTGRES_DB=videoexplore
DATABASE_URL=postgresql+psycopg://videoexplore:videoexplore@db:5432/videoexplore

# ===== Queue =====
REDIS_URL=redis://redis:6379/0

# ===== Paths(ホスト側)=====
# SMB共有をここにマウントする(README参照)。テスト用サンプルは ./data/videos に置く
VIDEO_HOST_DIR=./data/videos
# サムネイル等のキャッシュ
CACHE_HOST_DIR=./cache

# ===== 解析設定 =====
# ゼロショットタグ付けに使う画像-テキストモデル
# (フレーム埋め込みを本格保存するP2では google/siglip2-so400m-patch14-384 等へ変更推奨)
EMBED_MODEL=google/siglip2-base-patch16-256
# タグ採用しきい値(タグ軸softmax確率)
TAG_THRESHOLD=0.05
# 動画1本あたりの解析フレーム数
FRAMES_PER_VIDEO=12

# ===== GLM(GLM-5.3-Flash vLLM サーバ) =====
# ホスト側の vLLM OpenAI互換API(既定: http://<host>:8888/v1)
GLM_ENABLED=true
GLM_API_URL=http://host.docker.internal:8888/v1
GLM_MODEL=GLM-5.3-Flash-EXL3
# キャプションに使うキーフレーム数(1-3)
CAPTION_FRAMES=3
# API起動時に自動スキャンするか
AUTOSCAN_ON_STARTUP=false

# ===== Web =====
# ブラウザは WEB_PORT(3001)だけを使う。UI と API を nginx が同一オリジンで中継するため
# 別PCからアクセスしても動作する。NEXT_PUBLIC_API_URL は空欄(相対パス)でOK。
# 直接 API を叩きたい場合のみ API_PORT を開放。
NEXT_PUBLIC_API_URL=
API_PORT=8010
WEB_PORT=3001
